{
  "name": "vitrip",
  "version": "0.1.0",
  "private": true,
  "description": "ViTrip — 旅行对话与本地浏览器",
  "license": "MIT",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "tsc --noEmit && vite build && esbuild src/main/index.ts --bundle --platform=node --format=esm --external:electron --external:@earendil-works/* --external:sanitize-html --outfile=dist/main.mjs && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload.cjs",
    "start": "npm run build && electron .",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test",
    "package": "npm run build && node scripts/package.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.json",
    "format:check": "prettier --check src tests scripts/*.mjs *.ts *.json",
    "test:package": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.119",
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "ai": "7.0.116",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "jotai": "2.20.3",
    "lucide-react": "0.468.0",
    "nanoid": "6.0.1",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "2.17.7",
    "shiki": "4.4.3",
    "streamdown": "2.6.0",
    "tailwind-merge": "3.7.0",
    "typebox": "1.3.27",
    "use-stick-to-bottom": "1.1.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.1",
    "@vitejs/plugin-react": "6.1.1",
    "autoprefixer": "10.6.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "postcss": "8.5.28",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "3.2.7"
  },
  "packageManager": "npm@11.11.1",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  }
}
